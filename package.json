{
  "name": "pi-path-bar",
  "version": "0.4.1",
  "description": "A Pi extension for compact paths, folder aliases, and theme-aware Git status",
  "keywords": [
    "footer",
    "git",
    "path",
    "pi-extension",
    "pi-package",
    "terminal"
  ],
  "homepage": "https://github.com/johnbitcn/pi-path-bar#readme",
  "bugs": {
    "url": "https://github.com/johnbitcn/pi-path-bar/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnbitcn/pi-path-bar.git"
  },
  "files": [
    "src/",
    "assets/",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run check && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/reading-mode.ts"
    ],
    "image": "https://github.com/user-attachments/assets/a32b0049-9bf9-4093-8bfb-26a6cde21653"
  }
}
